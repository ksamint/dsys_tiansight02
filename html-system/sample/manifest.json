  "metrics": [
    {
      "id": "repurchase_rate",
      "name": "复购点击率",
      "en": "Repurchase click rate",
      "formula": "复购数量 ÷ 总销售数量",
      "numerator": "复购数量",
      "denominator": "总销售数量",
      "unit": "%",
      "grade": "E1",
      "sources": [
        "items",
        "monthly"
      ],
      "window_rule": "月窗只与月窗比，累计窗只与累计窗比；两者相差约 8 pp",
