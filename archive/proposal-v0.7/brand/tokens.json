{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Tiansight 侍天 design tokens, exported from brand/tokens.css (published guide v0.6). Do not edit; run scripts/export_tokens.py.",
  "$extensions": {
    "tiansight": {
      "version": "v0.6"
    }
  },
  "color": {
    "surface": {
      "$value": "#F4F0E7",
      "$type": "color",
      "$description": "淡墨纸 Pale Manuscript — base canvas"
    },
    "paper": {
      "$value": "#FFFDF8",
      "$type": "color",
      "$description": "宣纸 Paper — raised content"
    },
    "ink-primary": {
      "$value": "#EFE6D2",
      "$type": "color",
      "$description": "素墨 Ink — primary brand color: fields, key actions"
    },
    "charcoal": {
      "$value": "#17130D",
      "$type": "color",
      "$description": "玄墨 Charcoal — titles, primary text"
    },
    "gold": {
      "$value": "#76551F",
      "$type": "color",
      "$description": "土金 Earth Gold — rules, strokes, navigation"
    },
    "gold-hi": {
      "$value": "#D4A862",
      "$type": "color",
      "$description": "明金 Bright Gold — active state, key numbers"
    },
    "gold-deep": {
      "$value": "#76551F",
      "$type": "color",
      "$description": "深金 Deep Gold — captions, EN labels (same hex as --gold in v0.6)"
    },
    "ink-muted": {
      "$value": "#706758",
      "$type": "color",
      "$description": "素墨灰 Ink Muted — secondary text"
    },
    "seal": {
      "$value": "#8C3228",
      "$type": "color",
      "$description": "朱红 Vermillion — seal, negation, warnings, ≤ 5%"
    },
    "line": {
      "$value": "rgba(23, 19, 13, 0.18)",
      "$type": "color",
      "$description": "hairline"
    },
    "line-strong": {
      "$value": "rgba(23, 19, 13, 0.34)",
      "$type": "color",
      "$description": "hairline-strong"
    },
    "card-border": {
      "$value": "rgba(118, 85, 31, 0.34)",
      "$type": "color"
    },
    "rule": {
      "$value": "{color.gold}",
      "$description": "structural rule, 1px"
    },
    "watermark": {
      "$value": "rgba(118, 85, 31, 0.10)",
      "$type": "color",
      "$description": "compass ring behind heroes"
    },
    "scrim": {
      "$value": "rgba(23, 19, 13, 0.55)",
      "$type": "color"
    },
    "focus": {
      "$value": "rgba(118, 85, 31, 0.5)",
      "$type": "color",
      "$description": "text roles"
    },
    "text": {
      "$value": "{color.charcoal}"
    },
    "text-muted": {
      "$value": "{color.ink-muted}"
    },
    "text-caption": {
      "$value": "0.8125rem",
      "$type": "color",
      "$description": "13px"
    },
    "text-key": {
      "$value": "{color.gold-hi}",
      "$description": "key numbers, tagline — 28px+ or decorative only"
    },
    "text-on-charcoal": {
      "$value": "{color.surface}"
    },
    "text-on-charcoal-key": {
      "$value": "{color.gold-hi}",
      "$description": "state"
    },
    "positive": {
      "$value": "{color.gold-hi}",
      "$description": "✓"
    },
    "negative": {
      "$value": "{color.seal}",
      "$description": "✕, warnings"
    },
    "chart-1": {
      "$value": "{color.gold-hi}"
    },
    "chart-2": {
      "$value": "{color.charcoal}"
    },
    "chart-3": {
      "$value": "{color.seal}"
    },
    "chart-axis": {
      "$value": "{color.ink-muted}"
    },
    "chart-grid": {
      "$value": "{color.line}"
    },
    "chart-benchmark": {
      "$value": "rgba(112, 103, 88, 0.45)",
      "$type": "color",
      "$description": "── 2. Typography / 字体 ───────────────────────────────────"
    },
    "text-display": {
      "$value": "clamp(3rem, 8vw, 6rem)",
      "$type": "color",
      "$description": "48–96px, 侍天 lockup"
    },
    "text-h1": {
      "$value": "clamp(2.25rem, 5vw, 3.5rem)",
      "$type": "color",
      "$description": "36–56px"
    },
    "text-h2": {
      "$value": "clamp(1.75rem, 3.5vw, 2.5rem)",
      "$type": "color",
      "$description": "28–40px"
    },
    "text-h3": {
      "$value": "1.75rem",
      "$type": "color",
      "$description": "28px"
    },
    "text-body": {
      "$value": "1.125rem",
      "$type": "color",
      "$description": "18px"
    },
    "text-small": {
      "$value": "0.875rem",
      "$type": "color",
      "$description": "14px"
    },
    "text-mono": {
      "$value": "0.8125rem",
      "$type": "color",
      "$description": "13px"
    }
  },
  "font": {
    "font-cn": {
      "$value": "\"Noto Serif SC\", \"Source Han Serif SC\", \"Songti SC\", \"STSong\", serif",
      "$type": "fontFamily"
    },
    "font-en": {
      "$value": "\"Noto Serif\", \"Source Han Serif\", \"Songti SC\", serif",
      "$type": "fontFamily"
    },
    "font-mono": {
      "$value": "\"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace",
      "$type": "fontFamily"
    },
    "weight-aux": {
      "$value": "300",
      "$type": "fontWeight"
    },
    "weight-body": {
      "$value": "400",
      "$type": "fontWeight"
    },
    "weight-medium": {
      "$value": "500",
      "$type": "fontWeight"
    },
    "weight-title": {
      "$value": "600",
      "$type": "fontWeight"
    },
    "weight-strong": {
      "$value": "700",
      "$type": "fontWeight"
    }
  },
  "typography": {
    "leading-display": {
      "$value": "1",
      "$type": "number"
    },
    "leading-h1": {
      "$value": "1.1",
      "$type": "number"
    },
    "leading-h2": {
      "$value": "1.15",
      "$type": "number"
    },
    "leading-h3": {
      "$value": "1.3",
      "$type": "number"
    },
    "leading-body": {
      "$value": "1.7",
      "$type": "number"
    },
    "leading-small": {
      "$value": "1.8",
      "$type": "number"
    },
    "leading-caption": {
      "$value": "1.4",
      "$type": "number"
    },
    "leading-mono": {
      "$value": "1.5",
      "$type": "number"
    },
    "tracking-display": {
      "$value": "0.14em",
      "$type": "dimension"
    },
    "tracking-caps": {
      "$value": "0.34em",
      "$type": "dimension"
    },
    "tracking-caps-tight": {
      "$value": "0.3em",
      "$type": "dimension"
    },
    "tracking-tagline": {
      "$value": "0.5em",
      "$type": "dimension"
    },
    "measure-cn": {
      "$value": "36em",
      "$type": "dimension",
      "$description": "28–38 CN chars per line"
    },
    "measure-en": {
      "$value": "66ch",
      "$type": "dimension",
      "$description": "60–72 EN chars per line"
    }
  },
  "space": {
    "space-1": {
      "$value": "4px",
      "$type": "dimension"
    },
    "space-2": {
      "$value": "8px",
      "$type": "dimension"
    },
    "space-3": {
      "$value": "12px",
      "$type": "dimension"
    },
    "space-4": {
      "$value": "16px",
      "$type": "dimension"
    },
    "space-5": {
      "$value": "20px",
      "$type": "dimension"
    },
    "space-6": {
      "$value": "24px",
      "$type": "dimension"
    },
    "space-7": {
      "$value": "32px",
      "$type": "dimension"
    },
    "space-8": {
      "$value": "48px",
      "$type": "dimension"
    },
    "space-9": {
      "$value": "64px",
      "$type": "dimension"
    },
    "space-10": {
      "$value": "96px",
      "$type": "dimension"
    }
  },
  "layout": {
    "container": {
      "$value": "1280px",
      "$type": "dimension"
    },
    "columns": {
      "$value": "12",
      "$type": "dimension"
    },
    "gutter": {
      "$value": "48px",
      "$type": "dimension",
      "$extensions": {
        "tiansight.modes": {
          "mobile": "24px"
        }
      }
    },
    "section-gap": {
      "$value": "96px",
      "$type": "dimension",
      "$extensions": {
        "tiansight.modes": {
          "mobile": "64px"
        }
      }
    },
    "card-pad": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "20–28px card, 24–32px inner",
      "$extensions": {
        "tiansight.modes": {
          "mobile": "20px"
        }
      }
    },
    "card-pad-lg": {
      "$value": "32px",
      "$type": "dimension",
      "$extensions": {
        "tiansight.modes": {
          "mobile": "24px"
        }
      }
    },
    "swatch": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "token row swatch 30–34px"
    },
    "mark-min-inline": {
      "$value": "24px",
      "$type": "dimension"
    },
    "mark-min-hero": {
      "$value": "64px",
      "$type": "dimension",
      "$description": "motion — quiet, short, no bounce"
    }
  },
  "shape": {
    "radius": {
      "$value": "2px",
      "$type": "dimension",
      "$description": "never round"
    },
    "radius-pill": {
      "$value": "999px",
      "$type": "dimension",
      "$description": "outline status badge only"
    }
  },
  "motion": {
    "dur-fast": {
      "$value": "120ms",
      "$type": "duration"
    },
    "dur-base": {
      "$value": "220ms",
      "$type": "duration"
    },
    "dur-reveal": {
      "$value": "700ms",
      "$type": "duration"
    },
    "ease": {
      "$value": "cubic-bezier(0.2, 0.6, 0.2, 1)",
      "$type": "cubicBezier"
    },
    "ease-out": {
      "$value": "cubic-bezier(0.16, 1, 0.3, 1)",
      "$type": "cubicBezier"
    }
  },
  "z": {
    "z-sticky": {
      "$value": "100",
      "$type": "number"
    },
    "z-overlay": {
      "$value": "400",
      "$type": "number"
    },
    "z-modal": {
      "$value": "500",
      "$type": "number"
    }
  }
}
