      "verified": "全量逐行复算，最大偏差 3.4×10⁻³（导出端四位小数舍入）"
    },
    {
      "id": "member_penetration",
      "name": "会员渗透率",
      "formula": "（首次销售数量 + 复购数量）÷ 总销售数量",
      "unit": "%",
      "grade": "E1",
      "sources": [
        "items"
      ],
      "threshold": "低于 9 店 P75 = 59.64% 为缺口"
    },
    {
      "id": "gap_amount",
      "name": "月化缺口金额",
      "formula": "（对标复购点击率 − 门店复购点击率）× 总销量 × 会员单份均价 ÷ 7",
      "unit": "元",
      "grade": "E2",
      "sources": [
        "stores"
      ],
      "window_rule": "仅 9 店累计窗"
    },
    {
      "id": "recoverable",
      "name": "可争取利润",
      "formula": "Σ 可争取项 − Σ 流失项",
      "unit": "万元 / 季",
      "grade": "E3",
      "sources": [
        "budget"
      ],
      "threshold": "按 60–70% 达成率排预算"
    }
  ],
