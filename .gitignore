.DS_Store
.thumbnail
node_modules/
coverage/
__pycache__/
.env
.env.*
!.env.example
*.log
_ds_bundle.js
_ds_manifest.json
_adherence.oxlintrc.json
people/export/

snapshots/render/
/Design system review and deliverables.zip
/_site/

# report kit: build scratch and the Slides runtime (artifact-type code, not ours)
.build/
templates/report-kit/runtime/*
!templates/report-kit/runtime/README.md

# client deliverables stay local (docs/maintaining.md §6)
reference/source/*
!reference/source/README.md

# editors, credentials and local tooling (from the repository's initial commit)
.idea/
.vscode/
!.env.*.example
*.pem
*.key
.venv/
*.py[cod]

# Current versioned compiled component distribution is an intentional deliverable.
!dist/components/*/_ds_bundle.js

# Browser evidence is scratch; PDFs and versioned verification summaries are review artifacts.
build/**/.verification/

# Historical exports remain intact after their archive move.
!archive/**/_ds_bundle.js
!archive/**/_ds_manifest.json
!archive/**/_adherence.oxlintrc.json

# Interrupted PDF optimisation scratch is never a release artifact.
build/**/*.optimized.pdf
